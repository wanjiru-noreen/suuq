# Development configuration only. Never use these values in production.
# Docker Compose automatically reads the root .env file.
# The Go backend loads .env automatically from the working directory or its parent.
# Exported environment variables take precedence over values in this file.

# Shared development signing secret; generate a separate secret for deployment.
AUTH_SECRET=0594470bbdbbefd760acd6f0a3e5c45a1f283ae50ca0d9779f02153e3d18dce4

# Used when running Go from backend/. Compose uses /data/suuq.db instead.
DB_PATH=./data/suuq.db
